// SPDX-License-Identifier: GPL-3.0-or-later
//
// OnlineCoop override of the stock ModEventHandler (module 17). The stock
// class is kept verbatim; the only additions are the include and the
// forwarding calls marked [COOP]. This module is used instead of a new
// entry in Modules.cfg because overriding a script by name is the add-on
// mechanism the official sample uses, and it survives game updates that
// add modules to Modules.cfg.

#include "interfaces/UserModule_Interface.hps"
#include "modules/ModuleInterfaces.hps"
#include "coop/OnlineCoop_Core.hps" // [COOP]

//---------------------------------------------------

class cScrModEventHandler : iScrUserModule, iScrUserModule_Interface, iScrModEventHandler_Interface
{
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mCoop.Init(); // [COOP]

	}
	
	//------------------------------------------------------------
	
	void LoadUserConfig()
	{

	}
	
	//------------------------------------------------------------
	
	void SaveUserConfig()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	//MAP LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
		mCoop.OnMapEnter(apMap); // [COOP]
	}
	
	void OnMapLeave(cLuxMap @apMap)
	{
		mCoop.OnMapLeave(apMap); // [COOP]
	}
	
	//------------------------------------------------------------
	
	void PreloadData(cLuxMap @apMap)
	{
	}
		
	void CreateWorldEntities(cLuxMap @apMap)
	{
	
	}
	void DestroyWorldEntities(cLuxMap @apMap)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnEnterContainer(const tString&in asOldContainer)
	{
	
	}
	void OnLeaveContainer(const tString&in asNewContainer)
	{
	
	}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		mCoop.Update(afTimeStep); // [COOP]
	
	}
	
	void PostUpdate(float afTimeStep)
	{
	}
	
	void VariableUpdate(float afDeltaTime)
	{
	}
	
	void Reset()
	{
	}
	
	//------------------------------------------------------------

	void OnGui(float afFrameTime)
	{
		
	}
	
	void OnDraw(float afFrameTime)
	{
		
	}
	
	void OnPostRender(float afFrameTime)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{
	
	}
	void OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
	
	}
	
	//------------------------------------------------------------
	
	void OnExitPressed(){}
	void AppGotInputFocus(){}
	void AppLostInputFocus(){}
	
	
	//------------------------------------------------------------
	
	void TriggerEvent(eModEvent eventID)
	{
		for (int i=0;i<mListeners.size();i++)
		{
			int modID = mListeners[i];
			iModEventListener@ pHandler = cast<iModEventListener>(cLux_GetUserModuleFromID(modID));
			pHandler.OnModEvent(eventID);
		}
	}
	
	//------------------------------------------------------------
	
	void AddListener(int iModuleID)
	{
		for (int i=0;i<mListeners.size();i++)
			if (mListeners[i]==iModuleID)
				return;
		mListeners.push_back(iModuleID);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	cCoopCore mCoop; // [COOP]
	array<int> mListeners;
		
	//------------------------------------------------------------
}
